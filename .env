# ===== MongoDB Configuration =====
MONGODB_URI=mongodb://localhost:27017/earning-app

# ===== JWT Configuration =====
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
JWT_EXPIRE=30d

# ===== Server Configuration =====
PORT=5000
NODE_ENV=development

# ===== CORS Configuration - Allow All Origins =====
CORS_ORIGIN=*
ALLOW_ALL_ORIGINS=true
ALLOW_CREDENTIALS=true

# ===== Client Configuration =====
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ===== Database Options =====
DB_POOL_SIZE=10
DB_TIMEOUT=5000

# ===== Email Configuration (Optional) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_password
SMTP_FROM=noreply@earningapp.com

# ===== Payment Gateway (Optional - Razorpay) =====
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ===== App Settings =====
APP_NAME=Earning App
APP_VERSION=1.0.0
MIN_WITHDRAWAL=100
MAX_WITHDRAWAL=100000
TASK_REWARD_MIN=10
TASK_REWARD_MAX=1000
DEFAULT_TASK_REWARD=50

# ===== Admin Settings =====
ADMIN_EMAIL=admin@earningapp.com
ADMIN_PASSWORD=admin123

# ===== API Keys (Optional) =====
API_KEY_SECRET=your_api_key_secret
API_RATE_LIMIT=100

# ===== Logging =====
LOG_LEVEL=debug
LOG_FILE=./logs/app.log
